# JWT_SECRET তৈরি করুন: openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-random-characters-long
# লোকাল MongoDB বা Atlas-এর ঠিকানা (Atlas: mongodb+srv://ইউজার:পাসওয়ার্ড@cluster0.xxxxx.mongodb.net)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=madrasa
PORT=3000
# ফ্রন্টএন্ড আলাদা ডোমেইনে হলে সেই ডোমেইন (কমা দিয়ে একাধিক), যেমন https://madrasa.vercel.app
CORS_ORIGINS=
